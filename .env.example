NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional server-only aliases. If omitted, the public values above are used.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Usada na gestão de contas e na consulta de destinatários das notificações.
# Nunca usar uma variável NEXT_PUBLIC_ nem expor esta chave no browser.
SUPABASE_SERVICE_ROLE_KEY=

# Notificações de tarefas, comunicação, candidaturas, contactos e inovação. Nunca expor no browser nem colocar no repositório.
RESEND_API_KEY=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://riseupmaia.pt
