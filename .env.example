NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional server-only aliases. If omitted, the public values above are used.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only. Necessária apenas para a eliminação segura de uma conta pelo próprio utilizador.
# Nunca usar uma variável NEXT_PUBLIC_ nem expor esta chave no browser.
SUPABASE_SERVICE_ROLE_KEY=

# Notificações internas de tarefas. Nunca expor no browser nem colocar no repositório.
RESEND_API_KEY=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://riseupmaia.pt

# Google Drive library. Recommended for a folder in a personal "My Drive":
GOOGLE_DRIVE_ROOT_FOLDER_ID=18mdhHygC7zUMlU7U0r_2lR5SXkvg2s8T
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-long-lived-refresh-token

# Optional fallback for a Google Workspace Shared Drive. Service accounts
# cannot own or upload files into a personal "My Drive" folder.
GOOGLE_SERVICE_ACCOUNT_EMAIL=riseup-drive@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
